
<h1>Satış Sayfası</h1>

<div>
    <h2>Müşteri Bilgileri</h2>
    <p><strong>Ad:</strong> @Model.Name</p>
    <p><strong>Soyad:</strong> @Model.Surname</p>
    <p><strong>Şehir:</strong> @Model.City</p>
    <p><strong>Kimlik:</strong> @Model.Identity</p>
    <p><strong>Plaka:</strong> @Model.Plate</p>
    <p><strong>E-posta:</strong> @Model.Email</p>
    <p><strong>Doğum Günü:</strong> @Model.Birthday?.ToString("yyyy-MM-dd")</p>
    <p><strong>Durum:</strong> @Model.Status</p>
</div>

<div>
    <h2>Satış Yap</h2>
    <form method="post" action="/Sales/Create">
        <input type="hidden" name="CustomerId" value="@Model.Id" />
        <label for="Product">Ürün:</label>
        <input type="text" id="Product" name="Product" required />
        <label for="Amount">Miktar:</label>
        <input type="number" id="Amount" name="Amount" required />
        <button type="submit">Satış Yap</button>
    </form>
</div>