        <!--begin::Logo image-->
        <a href="/Home">
            <img alt="Logo" src="Resimler/ESarjLogo.png" class="h-75px app-sidebar-logo-default">

            <img alt="Logo" src="Resimler/ESarjLogo.png" class="h-60px app-sidebar-logo-minimize">
        </a>
        <!--end::Logo image-->

    </div>
    <!--end::Logo-->
    <!--begin::sidebar menu-->
    <div class="app-sidebar-menu overflow-hidden flex-column-fluid">
        <!--begin::Menu wrapper-->
        <div id="kt_app_sidebar_menu_wrapper" class="app-sidebar-wrapper">
            <!--begin::Scroll wrapper-->
            <div id="kt_app_sidebar_menu_scroll" class="scroll-y my-5 mx-3" data-kt-scroll="true" data-kt-scroll-activate="true" data-kt-scroll-height="auto" data-kt-scroll-dependencies="#kt_app_sidebar_logo, #kt_app_sidebar_footer" data-kt-scroll-wrappers="#kt_app_sidebar_menu" data-kt-scroll-offset="5px" data-kt-scroll-save-state="true">
                <!--begin::Menu-->
                <div class="menu menu-column menu-rounded menu-sub-indention fw-semibold fs-6" id="#kt_app_sidebar_menu" data-kt-menu="true" data-kt-menu-expand="false">

                    <!--begin:Menu item-->
                    
                    <div class="menu-item pt-5">
                        <!--begin:Menu content--><div class="menu-content"><span class="menu-heading fw-bold text-uppercase fs-7">Şehirlere Göre Ara</span></div><!--end:Menu content-->
                        <!-- ara input  -->

                        <div class="input-group mb-3">
                            <input type="text" class="form-control" name="sehirAdi" id="sehirAdi" placeholder="Şehir Adı Gir" aria-label="Şehir Adı Gir" aria-describedby="button-addon2">
                            <button class="btn btn-outline-secondary" type="button" id="button-addon2">Ara</button>
                        </div>

                        <!-- API'den gelen sonuçların gösterileceği alan -->
                        <div id="searchResults"></div>



                    </div><!--end:Menu item-->


                
                </div>
           
           
       


            </div>
            <!--end::Menu-->
        </div>
        <!--end::Scroll wrapper-->
    </div>
    <!--end::Menu wrapper-->
</div>


<!--end::sidebar menu-->



<script>
    $(document).ready(function () {
        // Sayfa yüklendiğinde İstanbul verilerini al ve listele
        $.ajax({
            url: `https://api.sarj.dev/v1/search/suggest?q=İstanbul`, // Varsayılan şehir İstanbul
            type: 'GET',
            success: function (response) {
                // Gelen veriyi ekliyoruz
                var results = response.suggestions || []; // API'den gelen veriyi alıyoruz
                var resultsHtml = '';

                // Verileri liste haline getiriyoruz
                if (results.length > 0) {
                    results.forEach(function (item) {
                        console.log(item);
                        resultsHtml += `<p>${item.highlightedText}</p>`; // Her öneriyi paragraf olarak ekliyoruz
                    });
                } else {
                    resultsHtml = '<p>Sonuç bulunamadı.</p>';
                }

                // Sonuçları input'un altına ekliyoruz
                $('#searchResults').html(resultsHtml);
            },
            error: function () {
                $('#searchResults').html('<p>API isteği sırasında bir hata oluştu.</p>');
            }
        });

        // Ara butonuna tıklandığında API'den şehir adına göre veri çek
        $('#button-addon2').on('click', function () {
            var sehirAdi = $('#sehirAdi').val(); // Input'tan şehir adını alıyoruz

            if (sehirAdi) {
                // API'ye istek gönderiyoruz
                $.ajax({
                    url: `https://api.sarj.dev/v1/search/suggest?q=${sehirAdi}`, // API URL'si
                    type: 'GET',
                    success: function (response) {
                        // Gelen veriyi ekliyoruz
                        var results = response.suggestions || []; // API'den gelen veriyi alıyoruz
                        var resultsHtml = '';

                        // Verileri liste haline getiriyoruz
                        if (results.length > 0) {
                            results.forEach(function (item) {
                                console.log(item);
                                resultsHtml += `<p>${item.highlightedText}</p>`; // Her öneriyi paragraf olarak ekliyoruz
                            });
                        } else {
                            resultsHtml = '<p>Sonuç bulunamadı.</p>';
                        }

                        // Sonuçları input'un altına ekliyoruz
                        $('#searchResults').html(resultsHtml);
                    },
                    error: function () {
                        $('#searchResults').html('<p>API isteği sırasında bir hata oluştu.</p>');
                    }
                });
            } else {
                alert('Lütfen bir şehir adı girin.');
            }
        });
    });
</script>
