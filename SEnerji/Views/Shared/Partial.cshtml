<script>
    $(document).ready(function () {
        // Sayfa yüklendiğinde tüm istasyonları listele
        listStations();

        // "Ara" butonuna tıklandığında bölge adıyla filtrele
        $('#button-addon2').on('click', function () {
            var stateOrProvince = $('#stateOrProvince').val().trim(); // Kullanıcının girdiği bölge adını al

            if (stateOrProvince) {
                // İlk harfi büyük yap
                stateOrProvince = stateOrProvince.charAt(0).toUpperCase() + stateOrProvince.slice(1);

                $('#searchResults').html('<p>Sonuçlar yükleniyor...</p>'); // Yükleme mesajı göster
                listStations(stateOrProvince, true); // Bölge adıyla filtreleme yap ve varsayılanları gizle
            } else {
                alert('Lütfen bir bölge adı girin.');
            }
        });

        // İstasyonları listeleme fonksiyonu
        function listStations(stateOrProvince = '', clearPrevious = false) {
            // OpenChargeMap API isteği
            $.ajax({
                url: `https://api.openchargemap.io/v3/poi`,
                type: 'GET',
                data: {
                    key: '1cff6936-69cb-4e68-80df-d479970e9251', // Buraya kendi OpenChargeMap API anahtarınızı koyun
                    countrycode: 'TR', // Türkiye için country code
                    'address.stateorprovince': encodeURIComponent(stateOrProvince) // Bölge filtresi
                },
                success: function (response) {
                    // Gelen sonuçları listeleme
                    var resultsHtml = '';
                    var filteredResults = response;

                    if (stateOrProvince) {
                        // Kullanıcının girdiği bölgeyi küçük harfe dönüştür ve boşlukları temizle
                        filteredResults = response.filter(function (item) {
                            return item.AddressInfo.StateOrProvince &&
                                item.AddressInfo.StateOrProvince.trim().toLowerCase() === stateOrProvince.trim().toLowerCase();
                        });
                    }

                    if (filteredResults.length > 0) {
                        filteredResults.forEach(function (item) {
                            resultsHtml += `
                                <div>
                                    <h4>${item.AddressInfo.Title}</h4>
                                    <p>${item.AddressInfo.AddressLine1}, ${item.AddressInfo.StateOrProvince || 'Bölge bilgisi yok'}</p>
                                </div><hr>`;
                        });
                    } else {
                        resultsHtml = '<p>Sonuç bulunamadı.</p>';
                    }

                    if (clearPrevious) {
                        $('#searchResults').html(resultsHtml);
                    } else {
                        $('#searchResults').append(resultsHtml);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("API Hatası:", status, error);
                    $('#searchResults').html('<p>API isteği sırasında bir hata oluştu.</p>');
                }
            });
        }
    });
</script>