    <script>
        $(".js-example-basic-single").select2();
        $("#kt_datepicker_1").flatpickr({
            enableTime: true,
            dateFormat: "Y-m-d H:i",
        });
        function AddNewCustomer() {

            // Formdaki verileri topluyoruz
            var password = $("#Password").val();
            var passwordRepeat = $("#PasswordRepeat").val();

            // Şifrelerin eşleşip eşleşmediğini kontrol ediyoruz
            if (password !== passwordRepeat) {
                Swal.fire({
                    icon: 'error',
                    title: 'Hata!',
                    text: 'Parolalar eşleşmiyor!',
                    confirmButtonText: 'Tamam'
                });
                return; // AJAX çağrısını yapmadan işlemi durdur
            }

            var customerData = {
                Name: $("#Name").val().toUpperCase(),
                Surname: $("#Surname").val().toUpperCase(),
                City: $(".js-example-basic-single option:selected").text(),
                Identity: $("#Identity").val(), // Sayıya dönüştür
                Plate: $("#Plate").val().toUpperCase(),
                Password: password, // Tek şifre verisi gönderiyoruz
                Email: $("#Email").val(),
                Birthday: $("#kt_datepicker_1").val() ? new Date($("#kt_datepicker_1").val()).toISOString() : null // ISO formatta tarih
            };
            // AJAX çağrısını yapıyoruz
            $.ajax({
                url: "/Login/SignUp", // Sunucu tarafındaki endpoint
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(customerData),
                success: function (response) {
                    // İşlem başarılıysa swal ile bildirim
                    Swal.fire({
                        icon: 'success',
                        title: 'Başarılı!',
                        text: ' Başarıyla Kayıt Oldunuz.',
                        confirmButtonText: 'Tamam'
                    }).then(() => {
                        // Swal kapandıktan sonra yönlendirme yap
                        window.location.href = 'https://localhost:7196/Login/Index';
                    });
                },
                error: function (xhr, status, error) {
                    // Hata durumunda swal ile uyarı
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata!',
                        text: 'Plake veya TC Zaten Kayıtlı.',
                        confirmButtonText: 'Tamam'
                    });
                    console.error(xhr.responseText);
                }
            });
        }
    </script>
