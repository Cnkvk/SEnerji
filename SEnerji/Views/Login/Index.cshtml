    <!--begin::Custom Javascript(used for this page only)-->
    <script src="~/assets/js/custom/authentication/sign-in/general.js"></script>
    <script>
        var hostUrl = "/metronic8/demo1/assets/";
        $('#SignIn').on("click", function () {
            const identity = $('#Identity').val().trim();
            const password = $('#Password').val().trim();

            // Basit doğrulama
            if (!identity || !password) {
                //e.preventDefault(); // Formun sunucuya gönderimini durdur
                Swal.fire({
                    icon: 'error',
                    title: 'Hata!',
                    text: 'Kullanıcı adı ve parola gereklidir.',
                    confirmButtonText: 'Tamam'
                });
                return false;
            }
            $.ajax({
                url: "/Login/SignIn",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ Identity: identity, Password: password }),
                success: function (response) {

                    window.location.href = "/Home";
                },
                error: function (xhr, status, error) {
                    Swal.fire({
                        title: "Hata!",
                        text: xhr?.responseText ?? "Bir hata oluştu. Lütfen tekrar deneyin.",
                        icon: "error",
                        confirmButtonText: "Tamam",
                    });
                    console.error("Hata:", error, xhr.responseText);
                },
            });

        });
    </script>



