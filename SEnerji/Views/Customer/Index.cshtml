    <script>

    $(document).ready(function () {
        $('#kt_ecommerce_products_table').DataTable({
            language: {
                "sDecimal": ",",
                "sEmptyTable": "Tabloda herhangi bir veri mevcut değil",
                "sInfo": "_TOTAL_ kayıttan _START_ - _END_ arasındaki kayıtlar gösteriliyor",
                "sInfoEmpty": "Kayıt yok",
                "sInfoFiltered": "(_MAX_ kayıt içerisinden bulunan)",
                "sInfoPostFix": "",
                "sInfoThousands": ".",
                "sLoadingRecords": "Yükleniyor...",
                "sProcessing": "İşleniyor...",
                "sSearch": "Ara:",
                "sZeroRecords": "Eşleşen kayıt bulunamadı",
                "oPaginate": {
                    "sFirst": "İlk",
                    "sLast": "Son",
                    "sNext": "Sonraki",
                    "sPrevious": "Önceki"
                },
                "oAria": {
                    "sSortAscending": ": artan sütun sıralamasını aktifleştir",
                    "sSortDescending": ": azalan sütun sıralamasını aktifleştir"
                },
                "select": {
                    "rows": {
                        "_": "%d kayıt seçildi",
                        "0": "",
                        "1": "1 kayıt seçildi"
                    }
                }
            }
        });
        $(".js-example-basic-single").select2();



        $("#kt_datepicker_1").flatpickr({
            enableTime: true,
            dateFormat: "Y-m-d H:i",
        });


    });

    function openUpdateModal(Id) {
        // Müşteri verilerini AJAX ile alıyoruz
        $.ajax({
            url: '/Customer/GetCustomerById',  // API endpoint
            type: 'GET',
            data: { id: Id },  // Müşteri ID'sini gönderiyoruz
            success: function (response) {
                // Veriyi aldıktan sonra modalı dolduruyoruz
                $('#Name').val(response.Name);
                $('#Surname').val(response.Surname);
                $('#Plate').val(response.Plate);
                $('#Email').val(response.Email);

                // Tarih formatını düzeltme
                if (response.Birthday) {
                    $('#kt_datepicker_1').val(new Date(response.Birthday).toISOString().slice(0, 19));  // ISO formatı
                }

                $('#Identity').val(response.Identity);

                // Select2 ile City'yi doğru şekilde dolduruyoruz
                $(".js-example-basic-single").val(response.City.id).trigger('change'); // ID'yi doğru şekilde gönderiyoruz

                // Modalı açıyoruz
                $('#kt_modal_1').modal('show');

                // Eğer Select2'yi AJAX ile güncellediyseniz, Select2'yi yeniden başlatın
                $(".js-example-basic-single").select2(); // Bu satır, Select2'yi tekrar başlatacaktır
            },

        });
    }



    function AddCustomer() {

        // Formdaki verileri topluyoruz
        var customerData = {
            Name: $("#Name").val().toUpperCase(),
            Surname: $("#Surname").val().toUpperCase(),
            City: $(".js-example-basic-single option:selected").text(),
            Identity: $("#Identity").val(), // Sayıya dönüştür
            Plate: $("#Plate").val().toUpperCase(),
            Email: $("#Email").val(),
            Birthday: $("#kt_datepicker_1").val() ? new Date($("#kt_datepicker_1").val()).toISOString() : null// ISO formatta tarih
        };

        // AJAX çağrısını yapıyoruz
        $.ajax({
            url: "/Customer/AddCustomer", // Sunucu tarafındaki endpoint
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(customerData),
            success: function (response) {
                // İşlem başarılıysa swal ile bildirim
                Swal.fire({
                    icon: 'success',
                    title: 'Başarılı!',
                    text: 'Müşteri başarıyla eklendi.',
                    confirmButtonText: 'Tamam'
                }).then(() => {
                    // Swal kapandıktan sonra yönlendirme yap
                    window.location.href = 'https://localhost:7196/Customer';
                });
            },
            error: function (xhr, status, error) {
                // Hata durumunda swal ile uyarı
                Swal.fire({
                    icon: 'error',
                    title: 'Hata!',
                    text: 'Müşteri eklenirken bir hata oluştu.',
                    confirmButtonText: 'Tamam'
                });
                console.error(xhr.responseText);
            }
        });
    }

    function RemoveCustomer(Id) {
        Swal.fire({
            title: 'Silmek istediğinize emin misiniz?',
            text: "Bu işlem geri alınamaz!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'Hayır, iptal et!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: `/Customer/RemoveCustomer?Id=${Id}`,
                    type: 'GET',
                    success: function (response) {
                        Swal.fire(
                            'Silindi!',
                            'Müşteri başarıyla silindi.',
                            'success'
                        ).then(() => {

                            location.reload();
                        });
                    },
                    error: function (xhr) {
                        Swal.fire(
                            'Hata!',
                            'Bir hata oluştu: ',
                            'error'
                        );
                    }
                });
            }
        });
    }

    function UpdateCustomer(Id) {
             var selectedText = $(".js-example-basic-single option:selected").text();
             var cleanedText = selectedText.replace("Seçiniz...", "").trim();
        var customerData = {
            Id: Id, // Güncellenen müşterinin kimliği
            Name: $("#Name").val().toUpperCase(),
            Surname: $("#Surname").val().toUpperCase(),
            City: cleanedText,
            Identity: $("#Identity").val(), // Kimlik bilgisi
            Plate: $("#Plate").val().toUpperCase(),
            Email: $("#Email").val(),
            Birthday: $("#kt_datepicker_1").val()
                ? new Date($("#kt_datepicker_1").val()).toISOString()
                : null // Tarih formatı
        };

        Swal.fire({
            title: 'Onaylıyor musunuz?',
            text: "Müşteri Bilgilerini Güncellemek istediğinizden emin misiniz?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, kaydet!',
            cancelButtonText: 'Hayır, iptal et!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Customer/UpdateCustomer',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(customerData),
                    success: function (response) {
                        Swal.fire(
                            'Güncellendi!',
                            'Müşteri başarıyla güncellendi.',
                            'success'
                        ).then(() => {
                            $("#kt_ecommerce_products_table").html(response);
                            window.location.href = 'https://localhost:7196/Customer';
                        });
                    },
                    error: function (xhr) {
                        Swal.fire(
                            'Hata!',
                            'Bir hata oluştu.',
                            'error'
                        );
                    }
                });
            }
        });
    }


</script>

