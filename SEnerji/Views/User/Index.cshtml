@functions {
    public string MaskString(string input)
    {
        if (input.Length <= 4)
            return input;

        var start = input.Substring(0, 2);
        var end = input.Substring(input.Length - 2, 2);
        var maskedPart = new string('*', input.Length - 4);

        return start + maskedPart + end;
    }
  }