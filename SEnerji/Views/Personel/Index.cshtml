                "sEmptyTable": "Tabloda herhangi bir veri mevcut değil",
                "sInfo": "_TOTAL_ kayıttan _START_ - _END_ arasındaki kayıtlar gösteriliyor",
                "sInfoEmpty": "Kayıt yok",
                "sInfoFiltered": "(_MAX_ kayıt içerisinden bulunan)",
                "sInfoPostFix": "",
                "sInfoThousands": ".",
                "sLoadingRecords": "Yükleniyor...",
                "sProcessing": "İşleniyor...",
                "sSearch": "Ara:",
                "sZeroRecords": "Eşleşen kayıt bulunamadı",
                "oPaginate": {
                    "sFirst": "İlk",
                    "sLast": "Son",
                    "sNext": "Sonraki",
                    "sPrevious": "Önceki"
                },
                "oAria": {
                    "sSortAscending": ": artan sütun sıralamasını aktifleştir",
                    "sSortDescending": ": azalan sütun sıralamasını aktifleştir"
                },
                "select": {
                    "rows": {
                        "_": "%d kayıt seçildi",
                        "0": "",
                        "1": "1 kayıt seçildi"
                    }
                }
            }
        });
        $(".js-example-basic-single").select2();



        $("#kt_datepicker_1").flatpickr({
            enableTime: true,
            dateFormat: "Y-m-d H:i",
        });
        

    });
    function openUpdateModal(Id) {
        $.ajax({
            url: `/Personel/GetPersonelById?id=${Id}`, // ID'yi burada dinamik olarak ekliyoruz
            type: 'GET',
            success: function (response) {
                console.log("Gelen yanıt:", response); // Gelen yanıtı konsola yazdırın
                var selectedText = $(".js-example-basic-single option:selected").text();
                var cleanedText = selectedText.replace("Seçiniz...", "").trim();
                if (response) {
                    $('#Name').val(response.Name || '');
                    $('#Surname').val(response.Surname || '');
                    $('#Salary').val(response.Salary || '');
                    $('#Email').val(response.Email || '');
                    $('#Identity').val(response.Identity || '');
                    $('#Password').val(response.Password || '');
                    $(".js-example-basic-single").val(response.City).trigger('change');
                } else {
                    console.error("Boş bir yanıt döndü!");
                }
               
                // Modalı açıyoruz
                $('#kt_modal_1').modal('show');
            },
            error: function (xhr, status, error) {
                console.error("Hata oluştu:", status, error);
                Swal.fire('Hata!', 'Personel verileri alınamadı.', 'error');
            }
        });
    }


    function AddPersonel() {
        // Formdaki verileri topluyoruz
        var personelData = {
            Name: $("#Name").val().toUpperCase(),
            Surname: $("#Surname").val().toUpperCase(),
            City: $(".js-example-basic-single option:selected").text(),
            Password: $("#Password").val(),
            Identity: $("#Identity").val(), // Sayıya dönüştür
            Salary: parseFloat($("#Salary").val()), // Burada Salary'yi sayıya çeviriyoruz
            Email: $("#Email").val()

        };


        // AJAX çağrısını yapıyoruz
        $.ajax({
            url: "/Personel/AddPersonel", // Sunucu tarafındaki endpoint
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(personelData),
            success: function (response) {
                // İşlem başarılıysa swal ile bildirim
                Swal.fire({
                    icon: 'success',
                    title: 'Başarılı!',
                    text: 'Personel başarıyla eklendi.',
                    confirmButtonText: 'Tamam'
                }).then(() => {
                    // Swal kapandıktan sonra yönlendirme yap
                    window.location.href = 'https://localhost:7196/Personel';
                });
            },
            error: function (xhr, status, error) {
                // Hata durumunda swal ile uyarı
                Swal.fire({
                    icon: 'error',
                    title: 'Hata!',
                    text: 'Müşteri eklenirken bir hata oluştu.',
                    confirmButtonText: 'Tamam'
                });
                console.error(xhr.responseText);
            }
        });
    }

    function RemovePersonel(Id) {
        Swal.fire({
            title: 'Silmek istediğinize emin misiniz?',
            text: "Bu işlem geri alınamaz!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'Hayır, iptal et!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: `/Personel/RemovePersonel?Id=${Id}`,
                    type: 'GET',
                    success: function (response) {
                        Swal.fire(
                            'Silindi!',
                            'Müşteri başarıyla silindi.',
                            'success'
                        ).then(() => {

                            location.reload();
                        });
                    },
                    error: function (xhr) {
                        Swal.fire(
                            'Hata!',
                            'Bir hata oluştu: ',
                            'error'
                        );
                    }
                });
            }
        });
    }

    function UpdatePersonel(Id) {
        var selectedText = $(".js-example-basic-single option:selected").text();
        var cleanedText = selectedText.replace("Seçiniz...", "").trim();
        var personelData = {
            Id: Id, // Güncellenen müşterinin kimliği
            Name: $("#Name").val().toUpperCase(),
            Surname: $("#Surname").val().toUpperCase(),
            City: cleanedText,
            Identity: $("#Identity").val(), // Kimlik bilgisi
            Salary: $("#Salary").val(),
            Email: $("#Email").val()
        };

        Swal.fire({
            title: 'Onaylıyor musunuz?',
            text: "Personel Bilgilerini Güncellemek istediğinizden emin misiniz?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, kaydet!',
            cancelButtonText: 'Hayır, iptal et!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Personel/UpdatePersonel',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(personelData),
                    success: function (response) {
                        Swal.fire(
                            'Güncellendi!',
                            'Müşteri başarıyla güncellendi.',
                            'success'
                        ).then(() => {
                            $("#kt_ecommerce_products_table").html(response);
                            window.location.href = 'https://localhost:7196/Personel';
                        });
                    },
                    error: function (xhr) {
                        Swal.fire(
                            'Hata!',
                            'Bir hata oluştu.',
                            'error'
                        );
                    }
                });
            }
        });
    }


    document.querySelector('[data-kt-ecommerce-product-filter="search"]').addEventListener('input', function () {
        var searchTerm = this.value.toLowerCase(); // Kullanıcının yazdığı değeri alıyoruz
        var rows = document.querySelectorAll('tr'); // Tablodaki tüm satırları alıyoruz

        // Tüm satırlarda gezinerek eşleşmeleri kontrol ediyoruz
        rows.forEach(function (row) {
            var nameCell = row.querySelector('td a[data-kt-ecommerce-product-filter="product_name"]'); // İsim hücresini buluyoruz
            if (nameCell) {
                var name = nameCell.textContent.toLowerCase(); // İsim hücresindeki metni alıyoruz
                if (name.includes(searchTerm)) {
                    row.style.display = ''; // Eşleşen isimleri gösteriyoruz
                } else {
                    row.style.display = 'none'; // Eşleşmeyen isimleri gizliyoruz
                }
            }
        });
    });


    document.querySelector('[data-kt-ecommerce-product-filter="search"]').addEventListener('input', function () {
        var searchTerm = this.value.toLowerCase();
        var rows = Array.from(document.querySelectorAll('tr')); // Tüm satırları alıyoruz ve bir diziye dönüştürüyoruz

        // Satırları sıralamak için eşleşenleri başa taşıyoruz
        rows.sort(function (a, b) {
            var nameA = a.querySelector('td a[data-kt-ecommerce-product-filter="product_name"]').textContent.toLowerCase();
            var nameB = b.querySelector('td a[data-kt-ecommerce-product-filter="product_name"]').textContent.toLowerCase();

            if (nameA.includes(searchTerm) && !nameB.includes(searchTerm)) {
                return -1; // nameA'yı en üste al
            } else if (!nameA.includes(searchTerm) && nameB.includes(searchTerm)) {
                return 1; // nameB'yi en üste al
            }
            return 0; // Değişiklik yoksa sıralamayı değiştirme
        });

        // Yeniden sıralanan satırları tabloya ekliyoruz
        var table = document.querySelector('table');
        rows.forEach(function (row) {
            table.appendChild(row); // Satırları sıralı şekilde tabloya ekliyoruz
        });
    });




    @functions {
        public string MaskString(string input)
        {
            if (input.Length <= 4)
                return input;

            var start = input.Substring(0, 2);
            var end = input.Substring(input.Length - 2, 2);
            var maskedPart = new string('*', input.Length - 4);

            return start + maskedPart + end;
        }
    }

</script>

