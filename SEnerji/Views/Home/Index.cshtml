<script src="~/assets/plugins/global/plugins.bundle.js"></script>
<script>
    // Slider için özellikler (şarj oranı)
    var slider = document.querySelector("#kt_slider_basic");
    var valueMin = document.querySelector("#kt_slider_basic_min");
    var valueMax = document.querySelector("#kt_slider_basic_max");

    noUiSlider.create(slider, {
        start: [20, 80],
        connect: true,
        range: {
            "min": 0,
            "max": 100
        }
    });

    slider.noUiSlider.on("update", function (values, handle) {
        if (handle) {
            valueMax.innerHTML = values[handle];
        } else {
            valueMin.innerHTML = values[handle];
        }
    });

    // Hesaplama butonuna tıkladığında yapılacak işlemler
    document.getElementById('calculateButton').addEventListener('click', function () {
        // Araç kW Değerini al
        var vehicleKw = parseFloat(document.getElementById('vehicleKw').value);

        // Seçilen kW değerini al
        var selectedKw = parseFloat(document.querySelector('input[name="plan"]:checked').value);

        // Slider'dan min ve max değerlerini al
        var min = parseFloat(valueMin.innerHTML);
        var max = parseFloat(valueMax.innerHTML);

        // Hesaplama: AraçKw * (Slider Max - Slider Min) * Seçilen KW
        var chargeTime = ((vehicleKw * (max - min)) / selectedKw);



        // Saat ve dakika olarak dönüştürme
        let hours = Math.floor(chargeTime / 60); // Saat kısmı
        let minutes = chargeTime % 60; // Dakika kısmı
        let minutesFormatted = minutes.toFixed(0);
        // Sonucu formatla ve görüntüle
        document.getElementById('chargeTimeResult').textContent = hours + " saat " + minutesFormatted + " dakika"; // 2 ondalıklı göster
    });
    document.getElementById('calculateButton').addEventListener('click', function () {
        // Araç kW Değerini al
        var vehicleKw = parseFloat(document.getElementById('vehicleKw').value);

        // Seçilen kW değerini al
        var selectedKw = parseFloat(document.querySelector('input[name="plan"]:checked').value);

        // Slider'dan min ve max değerlerini al
        var min = parseFloat(valueMin.innerHTML);
        var max = parseFloat(valueMax.innerHTML);

        // Hesaplama: Şarj için ihtiyaç duyulan enerji (kWh)
        var energyNeeded = ((vehicleKw * (max - min)) / 100);

        // Fiyat tarifelerini tanımla
        const pricing = {
            '240DC_PUBLIC': 9.90, // 240 kW'a kadar DC (Halka Açık)
            '120DC_PRIVATE': 8.90, // 120 kW'a kadar DC (Özel)
            '22AC_PUBLIC': 7.90, // 22 kW AC (Halka Açık)
            '22AC_PRIVATE': 6.90 // 22 kW AC (Özel)
        };

        // Fiyat tarifesi belirleme
        let pricePerKwh;
        if (selectedKw > 120) {
            pricePerKwh = pricing['240DC_PUBLIC']; // 240 kW DC tarifesi
        } else if (selectedKw > 60) {
            pricePerKwh = pricing['120DC_PRIVATE']; // 120 kW DC tarifesi
        } else if (selectedKw > 11) {
            pricePerKwh = pricing['22AC_PUBLIC']; // 22 kW AC (Halka Açık)
        } else {
            pricePerKwh = pricing['22AC_PRIVATE']; // 22 kW AC (Özel)
        }

        // Toplam fiyat hesaplama
        var totalPrice = energyNeeded * pricePerKwh;

        // Saat ve dakika olarak şarj süresi
        var chargeTime = energyNeeded / selectedKw * 60;
        let hours = Math.floor(chargeTime / 60); // Saat kısmı
        let minutes = chargeTime % 60; // Dakika kısmı
        let minutesFormatted = minutes.toFixed(0);

        // Sonuçları ekranda göster
        document.getElementById('chargeTimeResult').textContent = hours + " saat " + minutesFormatted + " dakika";
        document.getElementById('priceResult').textContent = totalPrice.toFixed(2) + " TL";
    });

    // Kullanıcının konumunu alalım (HTML5 Geolocation API)
    function getUserLocation(callback) {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {
                var userLocation = [position.coords.latitude, position.coords.longitude];
                callback(userLocation);
            }, function (error) {
                alert('Konum alınırken bir hata oluştu: ' + error.message);
                // Varsayılan bir konum kullanılabilir
                callback([39.9334, 32.8597]); // Ankara
            });
        } else {
            alert("Geolocation desteği bulunmuyor.");
            callback([39.9334, 32.8597]); // Varsayılan konum
        }
    }

    // Haritanın sağ alt köşesine "Konumumu Göster" butonu ekle
    L.Control.LocationButton = L.Control.extend({
        onAdd: function (map) {
            var container = L.DomUtil.create('div', 'leaflet-bar leaflet-control leaflet-control-custom');
            container.innerHTML = '<button style="background-color: white; border: 2px solid rgba(0,0,0,0.2); border-radius: 4px; padding: 5px; cursor: pointer;">📍 Konumumu Göster</button>';
            container.onclick = function () {
                getUserLocation(function (userLocation) {
                    map.setView(userLocation, 13); // Haritayı kullanıcının konumuna odakla
                    L.marker(userLocation, { icon: userIcon })
                        .addTo(map)
                        .bindPopup("Sizin Konumunuz")
                        .openPopup();
                });
            };
            return container;
        }
    });
</script>


