<!-- Leaflet.js kütüphanesini ve harita stilini dahil ediyoruz -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


<script type="text/javascript">
    window.onload = function () {
        // Model'den gelen marker verisini alıyoruz (ViewData'dan)
        var markers = @Html.Raw(ViewData["Markers"]);

        // Harita başlatma
        var map = L.map('dvMap').setView([39.0, 35.0], 6);

        // OpenStreetMap tile'larını ekliyoruz
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        // Model'den gelen her bir şarj istasyonunu haritada işaretliyoruz
        var myIcon = L.icon({
            iconUrl: '@Url.Content("~/Resimler/EsarjLogo.png")',  // İkonun URL'sini burada belirtin
            iconSize: [64, 64],  // İkonun boyutları
            iconAnchor: [16, 32],  // İkonun referans noktası
            popupAnchor: [0, -32]  // Popup pozisyonu
        });

        markers.forEach(function (item) {
            L.marker([item.Latitude, item.Longitude], { icon: myIcon })
                .bindPopup("<b>" + item.Title + "</b><br />" + item.AddressLine1 + " " + item.AddressLine2 + ", " + item.Town + ", " + item.StateOrProvince)
                .addTo(map);
        });

        // Kullanıcının konumunu almak için fonksiyon
        function getUserLocation(callback) {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (position) {
                    var userLocation = [position.coords.latitude, position.coords.longitude];
                    callback(userLocation);
                }, function (error) {
                    alert('Konum alınırken bir hata oluştu: ' + error.message);
                    callback([39.9334, 32.8597]); // Varsayılan konum (Ankara)
                });
            } else {
                alert("Tarayıcınız konum bilgisini desteklemiyor.");
                callback([39.9334, 32.8597]); // Varsayılan konum (Ankara)
            }
        }

        // Kullanıcı konumu için ikon
        var userIcon = L.icon({
            iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon.png', // Varsayılan ikon
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            popupAnchor: [1, -34]
        });

        // Haritanın sağ alt köşesine "Konumumu Göster" butonu ekle
        L.Control.LocationButton = L.Control.extend({
            onAdd: function (map) {
                var container = L.DomUtil.create('div', 'leaflet-bar leaflet-control leaflet-control-custom');
                container.innerHTML = '<button style="background-color: white; border: 2px solid rgba(0,0,0,0.2); border-radius: 4px; padding: 5px; cursor: pointer;">📍 Konumumu Göster</button>';
                container.onclick = function () {
                    getUserLocation(function (userLocation) {
                        map.setView(userLocation, 13); // Haritayı kullanıcının konumuna odakla
                        L.marker(userLocation, { icon: userIcon })
                            .addTo(map)
                            .bindPopup("Sizin Konumunuz")
                            .openPopup();
                    });
                };
                return container;
            }
        });

        // Butonu haritaya ekle
        new L.Control.LocationButton().addTo(map);
    };
</script>

