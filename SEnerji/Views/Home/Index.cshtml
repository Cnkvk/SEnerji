<script>
    // Slider için özellikler (şarj oranı)
    var slider = document.querySelector("#kt_slider_basic");
    var valueMin = document.querySelector("#kt_slider_basic_min");
    var valueMax = document.querySelector("#kt_slider_basic_max");

    noUiSlider.create(slider, {
        start: [20, 80],
        connect: true,
        range: {
            "min": 0,
            "max": 100
        }
    });

    slider.noUiSlider.on("update", function (values, handle) {
        if (handle) {
            valueMax.innerHTML = values[handle];
        } else {
            valueMin.innerHTML = values[handle];
        }
    });

    // Hesaplama butonuna tıkladığında yapılacak işlemler
    document.getElementById('calculateButton').addEventListener('click', function () {
        // Araç kW Değerini al
        var vehicleKw = parseFloat(document.getElementById('vehicleKw').value);

        // Seçilen kW değerini al
        var selectedKw = parseFloat(document.querySelector('input[name="plan"]:checked').value);

        // Slider'dan min ve max değerlerini al
        var min = parseFloat(valueMin.innerHTML);
        var max = parseFloat(valueMax.innerHTML);

        // Hesaplama: AraçKw * (Slider Max - Slider Min) * Seçilen KW
        var chargeTime = ((vehicleKw * (max - min)) / selectedKw);



        // Saat ve dakika olarak dönüştürme
        let hours = Math.floor(chargeTime / 60); // Saat kısmı
        let minutes = chargeTime % 60; // Dakika kısmı
        let minutesFormatted = minutes.toFixed(0);
        // Sonucu formatla ve görüntüle
        document.getElementById('chargeTimeResult').textContent = hours + " saat " + minutesFormatted + " dakika"; // 2 ondalıklı göster
    });
</script>


